/*
 * EXPERIMENTAL (M0): Redmi Note 8 Pro (begonia) camera power and the sensor I2C buses.
 * GENERATED by gen-camera-dtsi.py - do not edit by hand. The labels (pio, topckgen, camsys, spm, i2c2/4/7,
 * camvcamio) are placed by make-cam-dtb.sh.
 */

#include <dt-bindings/power/mediatek,mt6785-power.h>
#include <dt-bindings/clock/mediatek,mt6785-clk.h>
#include <dt-bindings/pinctrl/mediatek,mt6785-pinfunc.h>
#include <dt-bindings/gpio/gpio.h>

&pio {
	cam_i2c2_pins: cam-i2c2-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO112__FUNC_SCL2>,
				 <PINMUX_GPIO113__FUNC_SDA2>;
			bias-pull-up;
		};
	};

	cam_i2c4_pins: cam-i2c4-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO110__FUNC_SCL4>,
				 <PINMUX_GPIO111__FUNC_SDA4>;
			bias-pull-up;
		};
	};

	cam_i2c7_pins: cam-i2c7-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO198__FUNC_SCL7>,
				 <PINMUX_GPIO199__FUNC_SDA7>;
			bias-pull-up;
		};
	};

	cam0_rst0: cam0-rst0 {
		pins-cmd {
			pinmux = <PINMUX_GPIO118__FUNC_GPIO118>;
			output-low;
		};
	};
	cam0_rst1: cam0-rst1 {
		pins-cmd {
			pinmux = <PINMUX_GPIO118__FUNC_GPIO118>;
			output-high;
		};
	};
	cam0_pdn0: cam0-pdn0 {
		pins-cmd {
			pinmux = <PINMUX_GPIO93__FUNC_GPIO93>;
			output-low;
		};
	};
	cam0_pdn1: cam0-pdn1 {
		pins-cmd {
			pinmux = <PINMUX_GPIO93__FUNC_GPIO93>;
			output-high;
		};
	};
	cam0_vcama0: cam0-vcama0 {
		pins-cmd {
			pinmux = <PINMUX_GPIO114__FUNC_GPIO114>;
			output-low;
		};
	};
	cam0_vcama1: cam0-vcama1 {
		pins-cmd {
			pinmux = <PINMUX_GPIO114__FUNC_GPIO114>;
			output-high;
		};
	};
	cam0_vcamd0: cam0-vcamd0 {
		pins-cmd {
			pinmux = <PINMUX_GPIO114__FUNC_GPIO114>;
			output-low;
		};
	};
	cam0_vcamd1: cam0-vcamd1 {
		pins-cmd {
			pinmux = <PINMUX_GPIO114__FUNC_GPIO114>;
			output-high;
		};
	};
	cam0_mclk_off: cam0-mclk-off {
		pins-mclk {
			pinmux = <PINMUX_GPIO116__FUNC_GPIO116>;
			output-low;
		};
	};
	cam0_mclk_on: cam0-mclk-on {
		pins-mclk {
			pinmux = <PINMUX_GPIO116__FUNC_CMMCLK0>;
			drive-strength = <4>;  /* mA (mainline: 2..16 step 2); the raw vendor 1 = 4 mA */
		};
	};

	cam1_rst0: cam1-rst0 {
		pins-cmd {
			pinmux = <PINMUX_GPIO124__FUNC_GPIO124>;
			output-low;
		};
	};
	cam1_rst1: cam1-rst1 {
