&i2c2 {
	compatible = "xiaomi,mt6785-i2c-mch";
	mediatek,ch-offset = <0x100>;
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&cam_i2c2_pins>;
	status = "okay";
};

&i2c4 {
	compatible = "xiaomi,mt6785-i2c-mch";
	mediatek,ch-offset = <0x100>;
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&cam_i2c4_pins>;
	status = "okay";
};

&i2c7 {
	compatible = "xiaomi,mt6785-i2c-mch";
	mediatek,ch-offset = <0x100>;
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&cam_i2c7_pins>;
	status = "okay";
};

&{/soc} {
	camera_probe: camera-probe {
		compatible = "xiaomi,begonia-cam-probe";
		/* TWO domains on purpose (like md-bringup): otherwise the kernel turns cam on at bind. The driver attaches cam itself. */
		power-domains = <&spm MT6785_POWER_DOMAIN_CAM>, <&spm MT6785_POWER_DOMAIN_CONN>;
		power-domain-names = "cam", "conn";
		clocks = <&topckgen CLK_TOP_CAMTG1>, <&topckgen CLK_TOP_CAMTG2>,
			 <&topckgen CLK_TOP_CAMTG3>, <&topckgen CLK_TOP_CAMTG4>,
			 <&topckgen CLK_TOP_CAMTG5>,
			 <&topckgen CLK_TOP_UNIVPLL_192M_D8>,
			 <&camsys CLK_CAM_TG>;
		clock-names = "tg0", "tg1", "tg2", "tg3", "tg4", "src24", "camtg";
		vcamio-supply = <&camvcamio>;
		pinctrl-names =
			"cam0_rst0",
			"cam0_rst1",
			"cam0_pdn0",
			"cam0_pdn1",
			"cam0_vcama0",
			"cam0_vcama1",
			"cam0_vcamd0",
			"cam0_vcamd1",
			"cam0_mclk_off",
			"cam0_mclk_on",
			"cam1_rst0",
			"cam1_rst1",
			"cam1_pdn0",
			"cam1_pdn1",
			"cam1_vcama0",
			"cam1_vcama1",
			"cam1_vcamd0",
			"cam1_vcamd1",
			"cam1_mclk_off",
			"cam1_mclk_on",
			"cam2_rst0",
			"cam2_rst1",
			"cam2_pdn0",
			"cam2_pdn1",
			"cam2_vcama0",
			"cam2_vcama1",
			"cam2_vcamd0",
			"cam2_vcamd1",
			"cam2_mclk_off",
			"cam2_mclk_on",
			"cam3_rst0",
			"cam3_rst1",
			"cam3_pdn0",
			"cam3_pdn1",
			"cam3_vcama0",
			"cam3_vcama1",
			"cam3_vcamd0",
			"cam3_vcamd1",
			"cam3_mclk_off",
			"cam3_mclk_on",
			"cam4_rst0",
			"cam4_rst1",
			"cam4_pdn0",
			"cam4_pdn1",
			"cam4_vcama0",
			"cam4_vcama1",
			"cam4_vcamd0",
			"cam4_vcamd1",
			"cam4_mclk_off",
			"cam4_mclk_on",
			"sw0",
			"sw1";
		pinctrl-0 = <&cam0_rst0>;
		pinctrl-1 = <&cam0_rst1>;
		pinctrl-2 = <&cam0_pdn0>;
		pinctrl-3 = <&cam0_pdn1>;
		pinctrl-4 = <&cam0_vcama0>;
		pinctrl-5 = <&cam0_vcama1>;
		pinctrl-6 = <&cam0_vcamd0>;
		pinctrl-7 = <&cam0_vcamd1>;
		pinctrl-8 = <&cam0_mclk_off>;
		pinctrl-9 = <&cam0_mclk_on>;
		pinctrl-10 = <&cam1_rst0>;
		pinctrl-11 = <&cam1_rst1>;
		pinctrl-12 = <&cam1_pdn0>;
		pinctrl-13 = <&cam1_pdn1>;
		pinctrl-14 = <&cam1_vcama0>;
		pinctrl-15 = <&cam1_vcama1>;
		pinctrl-16 = <&cam1_vcamd0>;
		pinctrl-17 = <&cam1_vcamd1>;
		pinctrl-18 = <&cam1_mclk_off>;
		pinctrl-19 = <&cam1_mclk_on>;
		pinctrl-20 = <&cam2_rst0>;
		pinctrl-21 = <&cam2_rst1>;
		pinctrl-22 = <&cam2_pdn0>;
		pinctrl-23 = <&cam2_pdn1>;
		pinctrl-24 = <&cam2_vcama0>;
		pinctrl-25 = <&cam2_vcama1>;
		pinctrl-26 = <&cam2_vcamd0>;
		pinctrl-27 = <&cam2_vcamd1>;
		pinctrl-28 = <&cam2_mclk_off>;
		pinctrl-29 = <&cam2_mclk_on>;
		pinctrl-30 = <&cam3_rst0>;
		pinctrl-31 = <&cam3_rst1>;
		pinctrl-32 = <&cam3_pdn0>;
		pinctrl-33 = <&cam3_pdn1>;
		pinctrl-34 = <&cam3_vcama0>;
		pinctrl-35 = <&cam3_vcama1>;
		pinctrl-36 = <&cam3_vcamd0>;
		pinctrl-37 = <&cam3_vcamd1>;
		pinctrl-38 = <&cam3_mclk_off>;
		pinctrl-39 = <&cam3_mclk_on>;
		pinctrl-40 = <&cam4_rst0>;
		pinctrl-41 = <&cam4_rst1>;
		pinctrl-42 = <&cam4_pdn0>;
		pinctrl-43 = <&cam4_pdn1>;
		pinctrl-44 = <&cam4_vcama0>;
		pinctrl-45 = <&cam4_vcama1>;
		pinctrl-46 = <&cam4_vcamd0>;
		pinctrl-47 = <&cam4_vcamd1>;
		pinctrl-48 = <&cam4_mclk_off>;
		pinctrl-49 = <&cam4_mclk_on>;
		pinctrl-50 = <&cam_sw0>;
		pinctrl-51 = <&cam_sw1>;
	};
