		clock-controller@16000000 {
			compatible = "mediatek,mt6785-vdecsys", "syscon";
			reg = <0x00 0x16000000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x75>;
		};

		larb@16010000 {
			compatible = "mediatek,mt6785-smi-larb";
			reg = <0x00 0x16010000 0x00 0x1000>;
			mediatek,smi = <0x2b>;
			mediatek,larb-id = <0x02>;
			clocks = <0x75 0x00 0x75 0x01>;
			clock-names = "apb", "smi";
			power-domains = <0x55 0x0c>;
			phandle = <0x33>;
		};

		clock-controller@17000000 {
			compatible = "mediatek,mt6785-vencsys", "syscon";
			reg = <0x00 0x17000000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x76>;
		};

		larb@17010000 {
			compatible = "mediatek,mt6785-smi-larb";
			reg = <0x00 0x17010000 0x00 0x1000>;
			mediatek,smi = <0x2b>;
			mediatek,larb-id = <0x03>;
			clocks = <0x76 0x00 0x76 0x00>;
			clock-names = "apb", "smi";
			power-domains = <0x55 0x0d>;
			phandle = <0x34>;
		};

		clock-controller@19000000 {
			compatible = "mediatek,mt6785-apu_conn", "syscon";
			reg = <0x00 0x19000000 0x00 0x1000>;
			#clock-cells = <0x01>;
		};

		clock-controller@19020000 {
			compatible = "mediatek,mt6785-apu_vcore", "syscon";
			reg = <0x00 0x19020000 0x00 0x1000>;
			#clock-cells = <0x01>;
		};

		clock-controller@19180000 {
			compatible = "mediatek,mt6785-apu_core0", "syscon";
			reg = <0x00 0x19180000 0x00 0x1000>;
			#clock-cells = <0x01>;
		};

		clock-controller@19280000 {
			compatible = "mediatek,mt6785-apu_core1", "syscon";
			reg = <0x00 0x19280000 0x00 0x1000>;
			#clock-cells = <0x01>;
		};

		clock-controller@1a000000 {
			compatible = "mediatek,mt6785-camsys", "syscon";
			reg = <0x00 0x1a000000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x77>;
		};

		larb@1a001000 {
			compatible = "mediatek,mt6785-smi-larb";
			reg = <0x00 0x1a001000 0x00 0x1000>;
			mediatek,smi = <0x2b>;
			mediatek,larb-id = <0x06>;
			clocks = <0x77 0x00 0x77 0x00 0x58 0x08>;
			clock-names = "apb", "smi", "gals";
			power-domains = <0x55 0x01>;
			phandle = <0x36>;
		};
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		bootargs = [00];
	};

	haptic {
		compatible = "regulator-haptic";
		haptic-supply = <0x78>;
		max-microvolt = <0x2ab980>;
		min-microvolt = <0x124f80>;
	};

	i2c-sensors {
		compatible = "i2c-gpio";
		scl-gpios = <0x29 0x3d 0x06>;
		sda-gpios = <0x29 0x3e 0x06>;
		pinctrl-names = "default";
		pinctrl-0 = <0x79>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		magnetometer@c {
			compatible = "asahi-kasei,ak09918";
			reg = <0x0c>;
			vdd-supply = <0x3b>;
		};

		proximity@47 {
			compatible = "sensortek,stk3310";
			reg = <0x47>;
			interrupts-extended = <0x29 0x06 0x02>;
			proximity-near-level = <0x46>;
			pinctrl-names = "default";
			pinctrl-0 = <0x7a>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
	};

	scp {
		compatible = "mediatek,scp";
	};
};
