	fixed-factor-clock-13m {
		compatible = "fixed-factor-clock";
		#clock-cells = <0x00>;
		clocks = <0x25>;
		clock-div = <0x02>;
		clock-mult = <0x01>;
		clock-output-names = "clk13m";
		phandle = <0x30>;
	};

	oscillator-26m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x18cba80>;
		clock-output-names = "clk26m";
		phandle = <0x25>;
	};

	oscillator-32k {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		clock-output-names = "clk32k";
	};

	pmu-a55 {
		compatible = "arm,cortex-a55-pmu";
		interrupt-parent = <0x26>;
		interrupts = <0x01 0x07 0x08 0x27>;
	};

	pmu-a76 {
		compatible = "arm,cortex-a76-pmu";
		interrupt-parent = <0x26>;
		interrupts = <0x01 0x07 0x08 0x28>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x26>;
		interrupts = <0x01 0x0d 0x08 0x00 0x01 0x0e 0x08 0x00 0x01 0x0b 0x08 0x00 0x01 0x0a 0x08 0x00>;
	};

	soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		interrupt-controller@c000000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <0x04>;
			#redistributor-regions = <0x01>;
			interrupt-parent = <0x26>;
			interrupt-controller;
			reg = <0x00 0xc000000 0x00 0x40000 0x00 0xc040000 0x00 0x200000>;
			interrupts = <0x01 0x09 0x04 0x00>;
			phandle = <0x26>;

			ppi-partitions {

				interrupt-partition-0 {
					affinity = <0x16 0x17 0x18 0x19 0x1a 0x1b>;
					phandle = <0x27>;
				};

				interrupt-partition-1 {
					affinity = <0x1c 0x1d>;
					phandle = <0x28>;
				};
			};
		};

		clock-controller@c53a000 {
			compatible = "mediatek,mt6785-mcusys", "syscon";
