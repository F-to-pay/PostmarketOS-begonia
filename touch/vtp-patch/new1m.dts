			#interrupt-cells = <0x03>;
			interrupt-parent = <0x26>;
			reg = <0x00 0xc53a650 0x00 0x50>;
			phandle = <0x01>;
		};

		clock-controller@10000000 {
			compatible = "mediatek,mt6785-topckgen", "syscon";
			reg = <0x00 0x10000000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x03>;
