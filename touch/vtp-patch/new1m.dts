			#reset-cells = <0x01>;
			phandle = <0x2a>;
		};

		syscon@10003000 {
			compatible = "mediatek,mt6785-pericfg", "syscon";
			reg = <0x00 0x10003000 0x00 0x1000>;
			phandle = <0x46>;
		};

		pinctrl@10005000 {
			compatible = "mediatek,mt6785-pinctrl";
			reg = <0x00 0x10005000 0x00 0x1000 0x00 0x11c20000 0x00 0x1000 0x00 0x11d10000 0x00 0x1000 0x00 0x11e20000 0x00 0x1000 0x00 0x11e70000 0x00 0x1000 0x00 0x11ea0000 0x00 0x1000 0x00 0x11f20000 0x00 0x1000 0x00 0x11f30000 0x00 0x1000 0x00 0x1000b000 0x00 0x1000>;
			reg-names = "base", "rm", "br", "bl", "lb", "rt", "lt", "tl", "eint";
			interrupts = <0x00 0xcc 0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x29 0x00 0x00 0xca>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x29>;

			backlight-pins {
				phandle = <0x38>;

				pins-enable {
					pinmux = <0x1600>;
					output-high;
				};
			};

			i2c0-pins {
				phandle = <0x37>;

				pins-bus {
					pinmux = <0x3301 0x3401>;
					bias-pull-up;
				};
			};

			i2c1-pins {
				phandle = <0x79>;

				pins-bus {
					pinmux = <0x3d01 0x3e01>;
					bias-pull-up;
				};
			};

			i2c3-pins {
				phandle = <0x39>;

				pins-bus {
					pinmux = <0x3701 0x3801>;
					bias-pull-up;
				};
			};

			i2c5-pins {
				phandle = <0x3d>;

				pins-bus {
					pinmux = <0x1c01 0x1d01>;
					bias-pull-up;
				};
			};

			imu-pins {
				phandle = <0x3c>;

				pins-interrupt {
					pinmux = <0xa00>;
					bias-pull-down = <0x64>;
					input-enable;
				};
			};

			keypad-pins {
				phandle = <0x2f>;

				pins-volume {
					pinmux = <0x3b01 0x3c01>;
					input-enable;
				};
			};

			mmc1-pins {
				phandle = <0x4c>;

				pins-cmd-dat {
					pinmux = <0x8701 0x8901 0x8b01 0x8a01 0x8801>;
					bias-pull-up = <0x65>;
					drive-strength = <0x08>;
					input-enable;
				};

				pins-clk {
					pinmux = <0x8601>;
					bias-pull-down = <0x66>;
					drive-strength = <0x08>;
				};
			};

			mmc1-pins-detect {
				phandle = <0x4d>;

				pins-insert {
					pinmux = <0x800>;
					bias-pull-up;
					input-enable;
				};
			};

			mt6360-pins {
				phandle = <0x3e>;

				pins-interrupt {
					pinmux = <0x700 0x1000>;
					bias-pull-up;
					input-enable;
				};
			};

			panel-pins {
				phandle = <0x70>;

				pins-reset {
					pinmux = <0x2c00>;
				};
			};

			proximity-pins {
				phandle = <0x7a>;

				pins-interrupt {
					pinmux = <0x600>;
					bias-pull-up;
					input-enable;
				};
			};

			spi2-pins {
				phandle = <0x3a>;

				pins-bus {
					pinmux = <0x3f01 0x4001 0x4101 0x4201>;
					bias-disable;
				};
			};

			spi5-pins {
				phandle = <0x41>;

				pins-bus {
					pinmux = <0x2505 0x2405 0x2305 0x2605>;
					bias-disable;
				};
			};

			touchscreen-pins {
				phandle = <0x43>;

				pins-interrupt {
					pinmux = <0x100>;
					bias-pull-up;
					input-enable;
				};

				pins-reset {
					pinmux = <0x200>;
				};
			};
		};

