-					  IRQF_ONESHOT | IRQF_NO_AUTOEN |
-						nvt_ts_irq_type[irq_type],
+					  IRQF_ONESHOT | IRQF_NO_AUTOEN | irq_flags,
 					  dev_name(dev), data);
 	if (error)
 		return dev_err_probe(dev, error, "failed to request irq\n");
diff --git a/drivers/input/touchscreen/novatek-nvt-ts-spi.c b/drivers/input/touchscreen/novatek-nvt-ts-spi.c
