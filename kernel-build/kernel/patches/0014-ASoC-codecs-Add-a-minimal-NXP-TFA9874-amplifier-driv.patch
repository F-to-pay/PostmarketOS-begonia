 	imply SND_SOC_TLV320ADCX140
@@ -2095,6 +2096,16 @@ config SND_SOC_TFA9879
 	tristate "NXP Semiconductors TFA9879 amplifier"
 	depends on I2C
 
+config SND_SOC_TFA9874
