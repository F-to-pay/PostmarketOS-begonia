+static struct i2c_driver tfa9874_driver = {
+	.driver = {
+		.name = "tfa9874",
+		.of_match_table = tfa9874_of_match,
+	},
+	.probe = tfa9874_probe,
+	.remove = tfa9874_remove,
+	.id_table = tfa9874_i2c_id,
+};
