+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/mediatek,mt6359-fgadc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6359 PMIC fuel gauge (FGADC)
+
+maintainers:
+  - postmarketOS MT6785 mainline contributors
+
+description: |
+  The MT6359 PMIC has a coulomb counter and a current ADC (FGADC) that
+  measure the battery current over a sense resistor. The node is a child of
+  the PMIC node and registers a "battery" power supply.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6359-fgadc
+
+  io-channels:
+    maxItems: 1
+    description: Channel measuring the battery voltage.
+
+  io-channel-names:
+    const: voltage
+
+  power-supplies:
+    maxItems: 1
+    description: Charger that reports whether the battery is being charged.
+
+  monitored-battery:
+    description:
+      simple-battery node. Used are the design capacity, voltage limits,
+      factory-internal-resistance-micro-ohms and ocv-capacity-table-0.
+
+  shunt-resistor-micro-ohms:
+    default: 5000
+    description: Sense resistor of the FGADC.
+
+required:
+  - compatible
+  - io-channels
+  - io-channel-names
+  - monitored-battery
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    pmic {
+        fuel-gauge {
+            compatible = "mediatek,mt6359-fgadc";
+            io-channels = <&charger_adc 4>;
+            io-channel-names = "voltage";
+            power-supplies = <&charger>;
+            monitored-battery = <&battery>;
+            shunt-resistor-micro-ohms = <5000>;
+        };
+    };
