From 7c74d1f7c42ad6ee55c90bfaba7cb42c9c5ccd0a Mon Sep 17 00:00:00 2001
From: Begonia <begonia@localhost>
Date: Thu, 12 Nov 2026 22:15:47 +0100
Subject: [PATCH 10/18] arm64: dts: mediatek: mt6785-xiaomi-begonia: Add the
 infrared transmitter

The IR LED is on GPIO26 (PWM_0 function), driven by channel 0 of the
pwm0 controller through the generic pwm-ir-tx driver.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AZQBATYzaHUJbVewZp1YQs
---
 .../arm64/boot/dts/mediatek/irtx-begonia.dtsi | 35 +++++++++++++++++++
 .../dts/mediatek/mt6785-xiaomi-begonia.dts    |  1 +
 2 files changed, 36 insertions(+)
 create mode 100755 arch/arm64/boot/dts/mediatek/irtx-begonia.dtsi

diff --git a/arch/arm64/boot/dts/mediatek/irtx-begonia.dtsi b/arch/arm64/boot/dts/mediatek/irtx-begonia.dtsi
new file mode 100755
index 000000000..935464f79
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/irtx-begonia.dtsi
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * IR transmitter of the Redmi Note 8 Pro (begonia): the LED on GPIO26 (function PWM_0), PWM controller pwm0, channel 0.
+ * The vendor (mtk_irtx_pwm.c) drove it through PWM memory mode; mainline has a ready driver pwm-ir-tx
+ * (CONFIG_IR_PWM_TX): it chops the carrier with PWM by the timings. It creates /dev/lirc0 (ir-ctl --send).
+ * The default carrier is 38 kHz (26316 ns); the driver can change it and the duty cycle from userspace.
+ *
+ * Included at the end of arch/arm64/boot/dts/mediatek/mt6785-xiaomi-begonia.dts:
+ *     #include "irtx-begonia.dtsi"
+ */
+
+#include <dt-bindings/pinctrl/mediatek,mt6785-pinfunc.h>
+
+&pio {
+	irtx_pins: irtx-pins {
+		pins-irtx {
+			pinmux = <PINMUX_GPIO26__FUNC_PWM_0>;
+			slew-rate = <1>;
+			output-low;
+		};
+	};
+};
+
+&pwm0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&irtx_pins>;
+	status = "okay";
+};
+
+/ {
+	ir_tx: ir-transmitter {
+		compatible = "pwm-ir-tx";
+		pwms = <&pwm0 0 26316>;
+	};
+};
diff --git a/arch/arm64/boot/dts/mediatek/mt6785-xiaomi-begonia.dts b/arch/arm64/boot/dts/mediatek/mt6785-xiaomi-begonia.dts
index 247343adc..231eaf7b7 100755
--- a/arch/arm64/boot/dts/mediatek/mt6785-xiaomi-begonia.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6785-xiaomi-begonia.dts
@@ -821,3 +821,4 @@ &xhci {
 #include "consys-begonia.dtsi"
 
 #include "audio-begonia.dtsi"
+#include "irtx-begonia.dtsi"
